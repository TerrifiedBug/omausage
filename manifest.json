{
  "schemaVersion": 1,
  "id": "io.github.terrifiedbug.omausage",
  "name": "OmaUsage",
  "version": "1.1.0",
  "author": "TerrifiedBug",
  "license": "MIT",
  "description": "Usage limits for every AI subscription logged in to Oh My Pi, with each provider's logo and percentage in the bar.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaUsage",
    "description": "Provider logos and percentages in the bar, plus a panel with every limit, plan, and reset for each account logged in to Oh My Pi.",
    "category": "AI",
    "aliases": [
      "omp",
      "pi",
      "usage"
    ],
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 300,
      "barDisplay": "all",
      "percentShown": "left"
    },
    "schema": [
      {
        "key": "barDisplay",
        "type": "enum",
        "label": "Bar shows",
        "description": "Every provider with its logo and percentage, or only the one closest to its limit.",
        "options": [
          { "value": "all", "label": "All providers" },
          { "value": "most-used", "label": "Most used provider" }
        ],
        "defaultValue": "all"
      },
      {
        "key": "percentShown",
        "type": "enum",
        "label": "Percentages show",
        "description": "Applies to the bar, its tooltip, and the panel meters.",
        "options": [
          { "value": "left", "label": "Percent left" },
          { "value": "used", "label": "Percent used" }
        ],
        "defaultValue": "left"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 300
      }
    ],
    "defaultSection": "right"
  },
  "repository": null
}
